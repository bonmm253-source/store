# Dockerfile.flutter to build Android APK
FROM ghcr.io/cirruslabs/flutter:stable

# Set work directory
WORKDIR /app

# Ensure we have the latest tools
RUN flutter doctor

# Accept Android Licenses
RUN yes | flutter doctor --android-licenses

# Pre-download dependencies (optional but speeds up builds)
# We will copy the mobile folder from the host
COPY mobile/pubspec.yaml mobile/pubspec.lock* /app/mobile/
RUN cd mobile && flutter pub get || true

# Copy the rest of the mobile files
COPY mobile /app/mobile

# Build the APK
RUN cd mobile && flutter build apk --release

# The output will be in /app/mobile/build/app/outputs/flutter-apk/app-release.apk
CMD ["cp", "mobile/build/app/outputs/flutter-apk/app-release.apk", "/dist/app-release.apk"]
